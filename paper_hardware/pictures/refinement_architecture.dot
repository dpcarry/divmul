digraph refinement_architecture {
  graph [rankdir=TB, bgcolor="white", pad="0.10", nodesep="0.24", ranksep="0.34", fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.08,0.06", color="#34506b", penwidth=1.1];
  edge [color="#4b6073", penwidth=1.1, arrowsize=0.7, fontname="Helvetica", fontsize=8];
  bits [label="Mantissa bits\nselect local midpoint", fillcolor="#e8f0f7"];
  base [label="L0 base plane\nz_M^0 and w_0", fillcolor="#e3f2ed", penwidth=1.7];
  l1 [label="L1 correction\nshared partition bits", fillcolor="#fff3d8"];
  l2 [label="L2 correction\ncentered residual", fillcolor="#fff3d8"];
  l3 [label="L3 correction\ncentered / subtractor-free", fillcolor="#fff3d8"];
  mux [label="Level-prefix select\nL0 | L0+L1 | L0+L1+L2 | L0+L1+L2+L3", fillcolor="#fce8e6", penwidth=1.7];
  relation [label="DIV relation\nDelta w_n = -Delta z_n + shifted x term", fillcolor="#e3f2ed"];
  bits -> base;
  bits -> l1; bits -> l2; bits -> l3;
  base -> mux; l1 -> mux; l2 -> mux; l3 -> mux;
  mux -> relation;
}
