digraph runtime_architecture {
  graph [rankdir=LR, bgcolor="white", pad="0.12", nodesep="0.28", ranksep="0.38", fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.08,0.06", color="#34506b", penwidth=1.1];
  edge [color="#4b6073", penwidth=1.1, arrowsize=0.7, fontname="Helvetica", fontsize=8];
  in [label="FP32 inputs\nX, Y, mode, level", fillcolor="#e8f0f7"];
  unpack [label="FP32 front end\nsign / exponent / mantissa", fillcolor="#e8f0f7"];
  partition [label="Shared partition and\ncentered residual formation", fillcolor="#e3f2ed"];
  level [label="Runtime L0--L3\nprefix select", fillcolor="#fff3d8"];
  plane [label="Shared tangent-plane core\nbase plane + refinements", fillcolor="#e3f2ed", penwidth=1.8];
  scale [label="DIV path\nselect 1/(k_y)^2\nQ0.7 coefficient", fillcolor="#fce8e6"];
  bypass [label="MUL path\nplane bypass", fillcolor="#e8f0f7"];
  select [label="Mode select\nDIV or MUL", fillcolor="#fff3d8"];
  pack [label="Normalize and pack\nFP32 result", fillcolor="#e8f0f7"];
  out [label="FP32 output", fillcolor="#e8f0f7"];
  in -> unpack -> partition -> plane;
  unpack -> level [label=" level bits"];
  level -> plane [label=" enable L0...L3"];
  plane -> scale;
  plane -> bypass;
  scale -> select;
  bypass -> select;
  select -> pack -> out;
}
