digraph STDM {
  graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.55,
         size="15.5,5.0!", ratio=fill,
         labelloc=t, label="Shared STDM mantissa datapath after coefficient absorption and H recoding",
         fontsize=20, fontname="Times-Roman"];
  node [shape=box, style="filled", color="#263238", fontcolor="#263238",
        fontname="Times-Roman", fontsize=13, margin="0.13,0.09"];
  edge [color="#263238", arrowsize=0.7, penwidth=1.2, fontname="Times-Roman", fontsize=11];

  xm [label="x_m[22:0]", fillcolor="#dceef8"];
  ym [label="y_m[22:0]", fillcolor="#dceef8"];
  u [label="u = x_m[22-n:D_r]", fillcolor="#e4f2e8"];
  v [label="v = y_m[22-n:D_r]", fillcolor="#e4f2e8"];
  vx [label="v_s = v XOR {b{mode}}\n(short-field complement in DIV)", fillcolor="#fff1c9"];
  table [label="cell/mode table\n(A, B, T') <- (mode, i_x, i_y)\nL0: MUL (192,192,3264); DIV (89,89,1489)", fillcolor="#dceef8"];
  p1 [label="A x u\nunsigned", fillcolor="#e4f2e8"];
  p2 [label="B x v_s\nunsigned", fillcolor="#e4f2e8"];
  add [label="T' + Au + Bv_s\npositive accumulation", fillcolor="#fff1c9"];
  align [label="<< (D_r-S)", fillcolor="#edf0f2"];
  norm [label="Normalize", fillcolor="#edf0f2"];
  pack [label="FP32 pack", fillcolor="#dceef8"];
  result [shape=plain, style="", label="result"];

  xm -> u; ym -> v; v -> vx;
  xm -> table [label="leading n bits"];
  ym -> table [label="leading n bits"];
  u -> p1; vx -> p2;
  table -> p1 [label="A"];
  table -> p2 [label="B"];
  table -> add [label="T'"];
  p1 -> add; p2 -> add;
  add -> align -> norm -> pack -> result;
}
